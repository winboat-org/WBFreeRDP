+static char* xkb_rule_group(char* list, unsigned int group)
+{
+	for (unsigned int i = 0; i < group; i++)
+	{
+		char* delimiter = strchr(list, ',');
+		if (!delimiter)
+			return nullptr;
+		list = delimiter + 1;
+	}
+
+	char* delimiter = strchr(list, ',');
+	if (delimiter)
+		*delimiter = '\0';
+	return list;
+}
